rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /clubs/{clubId}/payments/{paymentId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /clubs/{clubId}/resources/{resourceId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /clubs/{clubId}/projects/{eventId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /clubs/{clubId}/articles/{articleId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /{clubId}/feedback/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
